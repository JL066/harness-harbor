# Harbor reads these variables from its parent process. It does not load this file.
HARBOR_CODEX_EXE=codex
# Generic custom Codex route. Required only for custom or official_then_custom.
# The API key is copied only into the child Codex environment and never argv.
# HARBOR_CODEX_CUSTOM_BASE_URL=https://api.example.invalid/v1
# HARBOR_CODEX_CUSTOM_API_KEY=
# HARBOR_CODEX_CUSTOM_MODEL=
HARBOR_MINIMAX_EXE=minimax
HARBOR_MINIMAX_CLI_EXE=mcode
HARBOR_MINIMAX_CONFIG=path/to/minimax-config.json
HARBOR_AGY_EXE=agy
# Safe default: leave empty. Set to 1 only after reviewing the risk in SECURITY.md.
HARBOR_AGY_DANGEROUSLY_SKIP_PERMISSIONS=

# Optional: use an absolute private queue root instead of the checkout's .jobs directory.
# HARBOR_JOBS_DIR=C:\path\to\private\harbor-jobs

# Required only by start-tunnel.ps1. Never commit real profile details.
HARBOR_TUNNEL_EXE=tunnel-client
HARBOR_TUNNEL_PROFILE_DIR=path/to/tunnel-profile-directory
HARBOR_TUNNEL_PROFILE=your-profile-name

# Optional launcher overrides. Leave unset to use the defaults in the scripts.
# HARBOR_PYTHON=python
# HARBOR_DAEMON_LOG=path/to/codex-job-daemon.log
# HARBOR_TUNNEL_LOG=path/to/tunnel-supervisor.log
